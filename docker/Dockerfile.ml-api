# Dockerfile pour le service ML API (prédictions de sentiment)
FROM python:3.11-slim

# Métadonnées
LABEL maintainer="Your Team"
LABEL description="ML API pour prédictions de sentiment Trustpilot"

# Variables d'environnement
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Créer le répertoire de travail
WORKDIR /app

# Installer les dépendances système
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copier les fichiers de requirements
COPY requirements.txt .

# Installer les dépendances Python
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install scikit-learn==1.7.2 joblib

# Copier le code de l'API
COPY api/ml_api.py ./api/

# Créer le répertoire pour les modèles
RUN mkdir -p /app/scripts/ml/models

# Exposer le port
EXPOSE 8001

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health')" || exit 1

# Commande de démarrage
CMD ["uvicorn", "api.ml_api:app", "--host", "0.0.0.0", "--port", "8001"]
